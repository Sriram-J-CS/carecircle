# Copy to .env and fill what you have. Everything is optional - the app runs with none of it.
JWT_SECRET=put-a-long-random-string-here-at-least-32-chars

# AI agent (get a free key at https://aistudio.google.com/apikey). Empty = rule engine only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real SMS + phone calls to relatives (Twilio). Empty = messages are only logged ("simulated").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Behaviour
CHECKIN_INTERVAL_HOURS=6
MISSED_AFTER_MIN=30
REQUIRE_PROOF=false        # true = pill-camera clip is mandatory to confirm a tablet
FACE_THRESHOLD=0.5         # lower = stricter face match
CORS_ORIGINS=http://localhost:5173   # in production: your exact frontend URL

# --- Security (set these for deployment) ---
APP_ENV=development        # production = hides /docs, enforces strong JWT_SECRET + exact CORS, adds HSTS
DEMO_MODE=true             # false in production: disables test-dose and outbox helpers
JWT_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_MIN=120
